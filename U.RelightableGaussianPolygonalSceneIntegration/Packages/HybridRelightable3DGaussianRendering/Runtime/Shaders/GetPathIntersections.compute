#pragma kernel CSMain
#include "Utils.cginc"
#include "sh.cginc"

StructuredBuffer<PathPayload> paths;
StructuredBuffer<uint> pathsContinueCounter;
StructuredBuffer<uint> pathsContinueCounterValue;
StructuredBuffer<GameObjectData> gameObjectDatas;
int gameObjectDataCount;
StructuredBuffer<AABB> aabbs;
StructuredBuffer<Triangle> triangles;
StructuredBuffer<Vertex> vertices;
StructuredBuffer<MaterialData> materialDatas;
StructuredBuffer<Gaussian> gaussians;
Texture2DArray<float4> albedoTextures;
Texture2DArray<float4> normalTextures;
Texture2DArray<float4> metallicSmoothnessTextures;
SamplerState sampleralbedoTextures;
SamplerState samplernormalTextures;
SamplerState samplermetallicSmoothnessTextures;
RWStructuredBuffer<PathHitRecord> pathHitRecords;
RWStructuredBuffer<uint> pathsContinueTmpCounter;
RWStructuredBuffer<PathHitRecord> sortedHitsBuffer;
RWStructuredBuffer<uint> stackBuffer;

/// <source> Sect. 3.1, Eq. 1 https://arxiv.org/pdf/2311.16043#page.4 </source>
float opacityAtPoint(float3 pos, Gaussian gauss){
    float4x4 invCov = invCovFromScalceScqrd(gauss.scaleSqrd);

    float4 pointToGaussianOrigin = float4((pos - gauss.pos), 1);
    float4 invCovTimesPointToGaussianOrigin = mul(invCov, pointToGaussianOrigin);
    float exponent = -0.5 * mul(transpose((float4x1)pointToGaussianOrigin), invCovTimesPointToGaussianOrigin);
    return pow(EULER_NUM, exponent);
}

float3 sphericalHarmonicsForLM(int l, int m, float coefficients[27], float3 v, 
    float coefficientIndexCounter){

    float shVal = shEval(l, m, v);
    
    // Add to total sum (The color)
    float redComp = coefficients[SHC_RED_START + coefficientIndexCounter] * shVal;
    float greenComp = coefficients[SHC_GREEN_START + coefficientIndexCounter] * shVal;
    float blueComp = coefficients[SHC_BLUE_START + coefficientIndexCounter] * shVal;

    return float3(redComp, greenComp, blueComp);
}

/// <summary> Calculate the color a gaussian is from a certain view direction 
/// using spherical harmonics. </summary>
float4 calcSphericalHarmonicsForPoint(float coefficients[27], float3 viewPointObjSpace, float3 gaussianCenter, float opacity){
    float3 shSums = float3(0, 0, 0);

    float3 diffVec = normalize(gaussianCenter - viewPointObjSpace);

    uint coefficientIndexCounter = 0;

    // I originally had this as a loop but the compiler was breaking it when they 
    // unrolled.
    shSums += sphericalHarmonicsForLM(0, 0, coefficients, diffVec, coefficientIndexCounter);
    coefficientIndexCounter+=1;
    
    shSums += sphericalHarmonicsForLM(1, -1, coefficients, diffVec, coefficientIndexCounter);
    coefficientIndexCounter+=1;
    shSums += sphericalHarmonicsForLM(1, 0, coefficients, diffVec, coefficientIndexCounter);
    coefficientIndexCounter+=1;
    shSums += sphericalHarmonicsForLM(1, 1, coefficients, diffVec, coefficientIndexCounter);
    coefficientIndexCounter+=1;

    shSums += sphericalHarmonicsForLM(2, -2, coefficients, diffVec, coefficientIndexCounter);
    coefficientIndexCounter+=1;
    shSums += sphericalHarmonicsForLM(2, -1, coefficients, diffVec, coefficientIndexCounter);
    coefficientIndexCounter+=1;
    shSums += sphericalHarmonicsForLM(2, 0, coefficients, diffVec, coefficientIndexCounter);
    coefficientIndexCounter+=1;
    shSums += sphericalHarmonicsForLM(2, 1, coefficients, diffVec, coefficientIndexCounter);
    coefficientIndexCounter+=1;
    shSums += sphericalHarmonicsForLM(2, 2, coefficients, diffVec, coefficientIndexCounter);

    shSums += float3(0.5, 0.5, 0.5);
    float4 shColor = float4(shSums.xyz, opacity);

    return shColor;
}

void insertionSortAndCull(uint idX, inout uint hitCount, PathHitRecord newHit)
{
    if (hitCount >= MAX_HIT)
    {
        return;
    }

    // insert new hit
    uint insertIdx;
    for (insertIdx = hitCount; insertIdx > 0; insertIdx--)
    {
        // storing PathHitRecord increase fps by 10 frames
        PathHitRecord prevHit = sortedHitsBuffer[insertIdx-1 + (idX * MAX_HIT)];
        if (prevHit.t <= newHit.t)
        {
            break;
        }
        sortedHitsBuffer[insertIdx + (idX * MAX_HIT)] = prevHit;
    }

    sortedHitsBuffer[insertIdx + (idX * MAX_HIT)] = newHit;
    hitCount++;

    if (hitCount == 1)
    {
        return;
    }

    // cull hits past max opacity
    float transmittance = 1.0;
    for (uint cullIdx = 0; cullIdx < hitCount; cullIdx++)
    {
        transmittance *= (1.0 - sortedHitsBuffer[cullIdx + (idX * MAX_HIT)].albedo.w);
        if (transmittance <= T_MIN)
        {
            hitCount = cullIdx + 1;
            return;
        }
    }
}

// push an item onto a stack
void stackPush(inout uint stackSize, uint pathId, uint toPush)
{
    if (stackSize >= STACK_MAX_SIZE)
    {
        return;
    }
    stackBuffer[stackSize + (pathId * STACK_MAX_SIZE)] = toPush;
    stackSize++;
}

// see the top item on a stack
uint stackPeek(inout uint stackSize, uint pathId)
{
    if (stackSize <= 0)
    {
        return 0;
    }
    return stackBuffer[stackSize - 1 + (pathId * STACK_MAX_SIZE)];
}

// remove the top item from the stack
uint stackPop(inout uint stackSize, uint pathId)
{
    if (stackSize <= 0)
    {
        return 0;
    }
    stackSize--;
    return stackBuffer[stackSize + (pathId * STACK_MAX_SIZE)];
}

[numthreads(128,1,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    if (id.x > pathsContinueCounterValue[0])
    {
        return;
    }

    uint pathId = pathsContinueCounter[id.x];
    PathPayload path = paths[pathId];

    PathHitRecord tmpHit = pathHitRecords[pathId];
    uint hitCount = 0;

    for (int i = 0; i < gameObjectDataCount; i++)
    {
        if (hitCount >= MAX_HIT)
        {
            break;
        }

        GameObjectData currGameObj = gameObjectDatas[i];
        float3 pathOriginObjSpace = mul(currGameObj.worldToObject, path.origin).xyz;
        float3 pathDirObjSpace = mul(currGameObj.worldToObject, path.direction).xyz;

        uint stackSize = 0;
        stackPush(stackSize, id.x, currGameObj.aabbRootIndex);

        // traverse BVH
        while (stackSize > 0)
        {
            uint currAABBIndex = stackPop(stackSize, id.x);
            AABB aabb = aabbs[currAABBIndex];

            if (rayAABBIntersect(pathOriginObjSpace, pathDirObjSpace, aabb))
            {

                // leaf node intersection
                if(aabb.primitiveCount < 4294967295U)
                {

                    if (aabb.primitiveType == PRIM_TYPE_GAUSSIAN)
                    {
                        // maximum gaussian reponse Relightable 3D Gaussians section 4.1, equation 14 https://arxiv.org/pdf/2311.16043#page.9
                        Gaussian gauss = gaussians[aabb.primitiveStartIndex];
                        float4x4 cov = covFromScalceScqrd(gauss.scaleSqrd);

                        float4 pathDirObjSpaceFlt4 = float4(pathDirObjSpace,0);
                        float4 covTimesPathDir = mul(cov, pathDirObjSpaceFlt4);

                        float1x4 pathOriginToGaussianOriginT = transpose((float4x1)float4((gauss.pos - pathOriginObjSpace), 1));
                        float numerator = mul(pathOriginToGaussianOriginT, covTimesPathDir);

                        float1x4 pathDirT = transpose((float4x1)pathDirObjSpaceFlt4);
                        float denominator = mul(pathDirT, covTimesPathDir);

                        float t = numerator / denominator;

                        if (t > 0)
                        {
                            float3 rx = pathOriginObjSpace + (t * pathDirObjSpace);
                            float opacity = opacityAtPoint(rx, gauss);
                            opacity *= gauss.opacity;
                            
                            
                            float3 pToO = rx - gauss.pos;
                            float dist = length(pToO);
                            

                            if (opacity > MIN_OPACITY )
                            {
                                //gauss.color.w = 1/*opacity * gauss.opacity*/;
                                float4 gColor = float4(gauss.shCoefficients[0], gauss.shCoefficients[9], gauss.shCoefficients[18], 1);

                                tmpHit.t = t;
                                tmpHit.materialType = MATERIAL_IS_EMISSIVE  ;
                                tmpHit.albedo = calcSphericalHarmonicsForPoint(gauss.shCoefficients, pathOriginObjSpace, gauss.pos, opacity);
                                //tmpHit.albedo = float4(1, 1, 1, opacity);
                                //tmpHit.albedo = float4(gColor.xyz, opacity);
                                tmpHit.normal = normalize(rx - gauss.pos);

                                insertionSortAndCull(id.x, hitCount, tmpHit);
                            }
                        }

                    }
                    else{
                       // ray-triangle intersection https://www.scratchapixel.com/lessons/3d-basic-rendering/ray-tracing-rendering-a-triangle/moller-trumbore-ray-triangle-intersection.html
                        for (uint j = 0; j < aabb.primitiveCount; j++)
                        {
                            Triangle tri = triangles[aabb.primitiveStartIndex + j];

                            float3 aToB = vertices[tri.v1].position - vertices[tri.v0].position;
                            float3 aToC = vertices[tri.v2].position - vertices[tri.v0].position;
                            float3 p = cross(pathDirObjSpace, aToC);

                            float det  = dot(p, aToB);
                            if (det < EPSILON)
                            {
                                continue;
                            }

                            float invDet = rcp(det);

                            float3 aToOrigin = pathOriginObjSpace - vertices[tri.v0].position;
                            float u = dot(p, aToOrigin) * invDet;
                            if (u < 0 || u > 1)
                            {
                                continue; 
                            }

                            float3 q = cross(aToOrigin, aToB);
                            float v = dot(q, pathDirObjSpace) * invDet;
                            if (v < 0 || u + v > 1)
                            {
                                continue;
                            }

                            float t = dot(q, aToC) * invDet;
                            
                            if (t > 0)
                            {
                                tmpHit.t = t;

                                MaterialData mat = materialDatas[currGameObj.materialIndex];
                                tmpHit.materialType = mat.type;

                                // albedo
                                float w = 1 - u - v;
                                float2 uv = vertices[tri.v0].uv * w + vertices[tri.v1].uv * u + vertices[tri.v2].uv * v;
                                if (mat.type & MATERIAL_HAS_ALBEDO_TEX)
                                {
                                    tmpHit.albedo = albedoTextures.SampleLevel(sampleralbedoTextures, float3(uv, mat.albedoTextureIndex), 0) * mat.albedo;
                                }
                                else
                                {
                                    tmpHit.albedo = mat.albedo;
                                }
                            
                                // normal
                                float3 normal;
                                if (mat.type & MATERIAL_HAS_NORMAL_TEX)
                                {
                                    normal = normalTextures.SampleLevel(samplernormalTextures, float3(uv, mat.normalTextureIndex), 0).xyz;
                                    normal = normalize(normal * 2.0 - 1.0);
                                }
                                else
                                {
                                    normal = normalize(vertices[tri.v0].normal * w + vertices[tri.v1].normal * u + vertices[tri.v2].normal * v);
                                }
                                float4 normalWorldSpace = mul(currGameObj.normalMatrix, float4(normal, 0));
                                tmpHit.normal = normalize(normalWorldSpace.xyz);

                                // metallic/smoothness
                                if (mat.type & MATERIAL_HAS_METALLIC_SMOOTHNESS_TEX)
                                {
                                    float4 sample = metallicSmoothnessTextures.SampleLevel(samplermetallicSmoothnessTextures, float3(uv, mat.metallicSmoothnessTextureIndex),0);
                                    tmpHit.metallic = sample.r;
                                    tmpHit.smoothness = sample.a;
                                }
                                else
                                {
                                    tmpHit.metallic = 0;
                                    tmpHit.smoothness = 0;
                                }

                                insertionSortAndCull(id.x, hitCount, tmpHit);
                            }
                        }

                    }


                }
                else
                {
                    stackPush(stackSize, id.x, aabb.leftChildIndex);
                    // If this AABB has a right child
                    if(aabb.rightChildIndex < 4294967295U){
                        stackPush(stackSize, id.x, aabb.rightChildIndex);
                    }
                }
            }
        }
    }

    if (hitCount > 0)
    {
        PathHitRecord lastHit = sortedHitsBuffer[hitCount-1 + (id.x * MAX_HIT)];
        tmpHit.t = lastHit.t;
        tmpHit.materialType = lastHit.materialType;
        tmpHit.albedo = float4(0,0,0,0);
        tmpHit.normal = lastHit.normal;
        tmpHit.metallic = 0;
        tmpHit.smoothness = 0;

        float accumulatedTransmittance = 1.0;
        for (uint hitIdx = 0; hitIdx < hitCount; hitIdx++)
        {
            PathHitRecord currHit = sortedHitsBuffer[hitIdx + (id.x * MAX_HIT)];

            float opacity = currHit.albedo.w;
            float weight = opacity * accumulatedTransmittance;
            tmpHit.albedo += float4(currHit.albedo.xyz * weight, 1);
            tmpHit.metallic += currHit.metallic * weight;
            tmpHit.smoothness += currHit.smoothness * weight;

            accumulatedTransmittance *= (1 - opacity);
        }

        pathHitRecords[pathId] = tmpHit;

        uint prevIndex = pathsContinueTmpCounter.IncrementCounter();
        pathsContinueTmpCounter[prevIndex] = pathId;
    }
}
#pragma kernel CSMain
#include "utils.cginc"

StructuredBuffer<PathPayload> paths;
StructuredBuffer<uint> pathsContinueCounter;
StructuredBuffer<uint> pathsContinueCounterValue;
StructuredBuffer<GameObjectData> gameObjectDatas;
int gameObjectDataCount;
StructuredBuffer<AABB> aabbs;
StructuredBuffer<Triangle> triangles;
StructuredBuffer<Vertex> vertices;
StructuredBuffer<MaterialData> materialDatas;
StructuredBuffer<Gaussian> gaussians;
Texture2DArray<float4> textures;
SamplerState samplertextures;
RWStructuredBuffer<PathHitRecord> pathHitRecords;
RWStructuredBuffer<uint> pathsContinueTmpCounter;
RWStructuredBuffer<PathHitRecord> sortedHitsBuffer;

// TODO: Is this equivalent to the opacity function?
/// <source> Sect. 3.1, Eq. 1 https://arxiv.org/pdf/2311.16043#page.4 </source>
float opacityAtPoint(float3 pos, Gaussian gauss){
    float4 pointToGaussianOrigin = float4((pos - gauss.pos), 1);
    float4 invCovTimesPointToGaussianOrigin = mul(gauss.invCov, pointToGaussianOrigin);
    float exponent = -0.5 * mul(transpose((float4x1)pointToGaussianOrigin), invCovTimesPointToGaussianOrigin);
    return pow(EULER_NUM, exponent);
}

void insertionSortAndCull(uint idX, inout uint hitCount, PathHitRecord newHit)
{
    if (hitCount >= MAX_HIT)
    {
        return;
    }

    // insert new hit
    uint insertIdx;
    for (insertIdx = hitCount; insertIdx > 0; insertIdx--)
    {
        // storing PathHitRecord increase fps by 10 frames
        PathHitRecord prevHit = sortedHitsBuffer[insertIdx-1 + (idX * MAX_HIT)];
        if (prevHit.t <= newHit.t)
        {
            break;
        }
        sortedHitsBuffer[insertIdx + (idX * MAX_HIT)] = prevHit;
    }

    sortedHitsBuffer[insertIdx + (idX * MAX_HIT)] = newHit;
    hitCount++;

    if (hitCount == 1)
    {
        return;
    }

    // cull hits past max opacity
    float transmittance = 1.0;
    for (uint cullIdx = 0; cullIdx < hitCount; cullIdx++)
    {
        transmittance *= (1.0 - sortedHitsBuffer[cullIdx + (idX * MAX_HIT)].albedo.w);
        if (transmittance <= 0.001)
        {
            hitCount = cullIdx + 1;
            return;
        }
    }
}

[numthreads(128,1,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    if (id.x > pathsContinueCounterValue[0])
    {
        return;
    }

    uint pathId = pathsContinueCounter[id.x];
    PathPayload path = paths[pathId];

    PathHitRecord tmpHit = pathHitRecords[pathId];
    uint hitCount = 0;

    for (int i = 0; i < gameObjectDataCount; i++)
    {
        if (hitCount >= MAX_HIT)
        {
            break;
        }

        GameObjectData currGameObj = gameObjectDatas[i];
        float3 pathOriginObjSpace = mul(currGameObj.worldToObject, float4(path.origin,1)).xyz;
        float3 pathDirObjSpace = mul(currGameObj.worldToObject, path.direction).xyz;

        // TODO: traverse AABB
        AABB aabb = aabbs[currGameObj.aabbRootIndex];

        if (aabb.primitiveType == PRIM_TYPE_TRIANGLE)
        {
            // ray-triangle intersection https://www.scratchapixel.com/lessons/3d-basic-rendering/ray-tracing-rendering-a-triangle/moller-trumbore-ray-triangle-intersection.html
            for (uint j = 0; j < aabb.primitiveCount; j++)
            {
                Triangle tri = triangles[aabb.primitiveStartIndex + j];

                float3 aToB = vertices[tri.v1].position - vertices[tri.v0].position;
                float3 aToC = vertices[tri.v2].position - vertices[tri.v0].position;
                float3 p = cross(pathDirObjSpace, aToC);

                float det  = dot(p, aToB);
                if (det < EPSILON)
                {
                    continue;
                }

                float invDet = rcp(det);

                float3 aToOrigin = pathOriginObjSpace - vertices[tri.v0].position;
                float u = dot(p, aToOrigin) * invDet;
                if (u < 0 || u > 1)
                {
                    continue; 
                }

                float3 q = cross(aToOrigin, aToB);
                float v = dot(q, pathDirObjSpace) * invDet;
                if (v < 0 || u + v > 1)
                {
                    continue;
                }

                float t = dot(q, aToC) * invDet;
                
                if (t > 0)
                {
                    tmpHit.t = t;

                    MaterialData mat = materialDatas[currGameObj.materialIndex];
                    tmpHit.materialType = mat.type;

                    float w = 1 - u - v;
                    if (mat.type != MATERIAL_TEXTURED)
                    {
                        tmpHit.albedo = mat.albedo;
                    }
                    else
                    {
                        float2 albedoUV = vertices[tri.v0].albedoUV * w + vertices[tri.v1].albedoUV * u + vertices[tri.v2].albedoUV * v;
                        tmpHit.albedo = textures.SampleLevel(samplertextures, float3(albedoUV, mat.albedoTextureIndex), 0) * mat.albedo;
                    }

                    float4 normal = mul(currGameObj.normalMatrix, float4(vertices[tri.v0].normal * w + vertices[tri.v1].normal * u + vertices[tri.v2].normal * v, 0));
                    tmpHit.normal = normalize(normal.xyz);

                    insertionSortAndCull(id.x, hitCount, tmpHit);
                }
            }
        }
        else
        {
            // ray-Gaussian intersection

            // maximum gaussian contribution Relightable 3D Gaussians section 4.1, equation 14 https://arxiv.org/pdf/2311.16043#page.9
            Gaussian gauss = gaussians[aabb.primitiveStartIndex];

            float4 covTimesPathDir = mul(gauss.cov, path.direction);

            float1x4 pathOriginToGaussianOriginT = transpose((float4x1)float4((gauss.pos - path.origin), 0));
            float numerator = mul(pathOriginToGaussianOriginT, covTimesPathDir);

            float1x4 pathDirT = transpose((float4x1)path.direction);
            float denominator = mul(pathDirT, covTimesPathDir);

            float t = numerator / denominator;

            if (t > 0)
            {
                // rx is the point where this Gaussian has maximum influence on this Gaussian
                float3 rx = path.origin + (t * path.direction.xyz);
                gauss.color.w = opacityAtPoint(rx, gauss);
               
                tmpHit.t = t;
                tmpHit.materialType = MATERIAL_EMISSIVE;
                tmpHit.albedo = gauss.color;
                tmpHit.normal = normalize(rx - gauss.pos);

                insertionSortAndCull(id.x, hitCount, tmpHit);
            }
        }
    }

    // TODO: add Gaussian script you can attach to objects and transform

    // TODO: merge main into branch
   
    if (hitCount > 0)
    {
        PathHitRecord lastHit = sortedHitsBuffer[hitCount-1 + (id.x * MAX_HIT)];
        tmpHit.t = lastHit.t;
        tmpHit.materialType = MATERIAL_DIFFUSE;
        tmpHit.albedo = float4(0,0,0,0);
        tmpHit.normal = lastHit.normal;

        float accumulatedTransmittance = 1.0;
        for (uint hitIdx = 0; hitIdx < hitCount; hitIdx++)
        {
            PathHitRecord currHit = sortedHitsBuffer[hitIdx + (id.x * MAX_HIT)];
            if (currHit.materialType == MATERIAL_EMISSIVE)
            {
                tmpHit.materialType = MATERIAL_EMISSIVE;
            }

            tmpHit.albedo += (currHit.albedo * currHit.albedo.w) * accumulatedTransmittance;
            accumulatedTransmittance *= (1 - currHit.albedo.w);
        }

        pathHitRecords[pathId] = tmpHit;

        uint prevIndex = pathsContinueTmpCounter.IncrementCounter();
        pathsContinueTmpCounter[prevIndex] = pathId;
    }
}
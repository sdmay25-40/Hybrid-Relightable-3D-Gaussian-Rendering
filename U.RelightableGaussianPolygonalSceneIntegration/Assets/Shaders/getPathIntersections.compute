#pragma kernel CSMain
#include "utils.cginc"
#include "stack.cginc"

StructuredBuffer<PathPayload> paths;
StructuredBuffer<uint> pathsContinueCounter;
StructuredBuffer<uint> pathsContinueCounterValue;
StructuredBuffer<GameObjectData> gameObjectDatas;
int gameObjectDataCount;
StructuredBuffer<AABB> aabbs;
StructuredBuffer<Triangle> triangles;
StructuredBuffer<Vertex> vertices;
StructuredBuffer<MaterialData> materialDatas;
Texture2DArray<float4> textures;
SamplerState samplertextures;
RWStructuredBuffer<PathHitRecord> pathHitRecords;
RWStructuredBuffer<uint> pathsContinueTmpCounter;
RWStructuredBuffer<uint> stackBuffer;

// Create a new empty stack
Stack stackInit(uint pathId, uint stackTop){
    Stack s;
    s.size = 1u;
    s.headIndex = 1u;
    s.pathId = pathId;
    stackBuffer[s.headIndex + (s.pathId * STACK_MAX_SIZE)] = stackTop;


    return s;
}

// Push an item onto a stack
Stack stackPush(Stack s, uint toPush){
    s.size += 1u;
    s.headIndex += 1u;
    stackBuffer[s.headIndex + (s.pathId * STACK_MAX_SIZE)] = toPush;

    return s;
}

// See the top item on a stack
uint stackPeek(Stack s){
    return stackBuffer[s.headIndex + (s.pathId * STACK_MAX_SIZE)];
}

// Remove the top item from the stack
Stack stackPop(Stack s){
    s.size -= 1u;
    s.headIndex -= 1u;

    return s;
}

[numthreads(128,1,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    if (id.x > pathsContinueCounterValue[0])
    {
        return;
    }

    uint pathId = pathsContinueCounter[id.x];
    PathPayload path = paths[pathId];

    PathHitRecord closestHit = pathHitRecords[pathId];
    closestHit.t = FLT_MAX;


    for (int i = 0; i < gameObjectDataCount; i++)
    {
        GameObjectData currGameObj = gameObjectDatas[i];
        float3 pathOriginObjSpace = mul(currGameObj.worldToObject, float4(path.origin,1)).xyz;
        float3 pathDirObjSpace = mul(currGameObj.worldToObject, path.direction).xyz;
        PathPayload pathObjSpace;
        pathObjSpace.origin = pathOriginObjSpace;
        pathObjSpace.direction = float4(pathDirObjSpace, 1);

        AABB aabb = aabbs[currGameObj.aabbRootIndex];
            
        // Create a stack and add the root to it.
        Stack s = stackInit(id.x, currGameObj.aabbRootIndex);

        while(s.size > 0){
            // Take top AABB off the stack
            uint currAABBIndex = stackPeek(s);
            s = stackPop(s);
            AABB aabb = aabbs[currAABBIndex];


            // If the ray intersects this AABB
            if(rayAABBIntersect(pathObjSpace, aabb)){
                // If this is a leaf node check for triangle intersections
                if(aabb.triangleCount < 4294967295U){
                    // ray-triangle intersection https://www.scratchapixel.com/lessons/3d-basic-rendering/ray-tracing-rendering-a-triangle/moller-trumbore-ray-triangle-intersection.html
                    for (uint j = 0; j < aabb.triangleCount; j++)
                    {
                        Triangle tri = triangles[aabb.triangleStartIndex + j];
                        float3 aToB = vertices[tri.v1].position - vertices[tri.v0].position;
                        float3 aToC = vertices[tri.v2].position - vertices[tri.v0].position;
                        float3 p = cross(pathDirObjSpace, aToC);

                        float det  = dot(p, aToB);
                        if (det < EPSILON)
                        {
                            continue;
                        }

                        float invDet = rcp(det);

                        float3 aToOrigin = pathOriginObjSpace - vertices[tri.v0].position;
                        float u = dot(p, aToOrigin) * invDet;
                        if (u < 0 || u > 1)
                        {
                            continue; 
                        }

                        float3 q = cross(aToOrigin, aToB);
                        float v = dot(q, pathDirObjSpace) * invDet;
                        if (v < 0 || u + v > 1)
                        {
                            continue;
                        }

                        float t = dot(q, aToC) * invDet;

                        if (t < closestHit.t && t > 0)
                        {
                            closestHit.t = t;

                            MaterialData mat = materialDatas[currGameObj.materialIndex];
                            closestHit.materialType = mat.type;

                            float w = 1 - u - v;
                            if (mat.type != MATERIAL_TEXTURED)
                            {
                                closestHit.albedo = mat.albedo;
                            }
                            else
                            {
                                float2 albedoUV = vertices[tri.v0].albedoUV * w + vertices[tri.v1].albedoUV * u + vertices[tri.v2].albedoUV * v;
                                closestHit.albedo = textures.SampleLevel(samplertextures, float3(albedoUV, mat.albedoTextureIndex), 0) * mat.albedo;
                            }

                            // float4 normal = mul(currGameObj.normalMatrix, float4(cross(aToB, aToC), 0));
                            // normal.w = 0;
                            // closestHit.normal = normalize(normal);
                            float4 normal = mul(currGameObj.normalMatrix, float4(vertices[tri.v0].normal * w + vertices[tri.v1].normal * u + vertices[tri.v2].normal * v, 0));
                            closestHit.normal = normalize(normal.xyz);
                        }
                    }
                }
                // If this is a tree node add children to the stack
                else{
                    s = stackPush(s, aabb.leftChildIndex);
                    s = stackPush(s, aabb.rightChildIndex);
                }
            }

            
        }

    }
   
    if (closestHit.t < FLT_MAX)
    {
        pathHitRecords[pathId] = closestHit;

        uint prevIndex = pathsContinueTmpCounter.IncrementCounter();
        pathsContinueTmpCounter[prevIndex] = pathId;
    }
}
#pragma kernel CSMain
#include "utils.cginc"

RWStructuredBuffer<PathPayload> paths;
StructuredBuffer<int> pathsEnd;
float4 cameraWorldPos;
float tanFovHalf;
uint screenWidth;
float invScreenHeight;
uint pathsPerPixel;

[numthreads(32,1,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    uint pathId = id.x / pathsPerPixel;


    float pixelXDirCamPos = ((2 * x + 1) * invScreenHeight - screenWidth * invScreenHeight) * tanFovHalf;
    float pixelYDirCamPos = ((-2 * y - 1) * invScreenHeight + 1) * tanFovHalf;
}
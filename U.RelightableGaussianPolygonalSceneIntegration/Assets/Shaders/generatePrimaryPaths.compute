#pragma kernel CSMain
#include "utils.cginc"

StructuredBuffer<uint> pathsEndCounter;
int pathCount;
StructuredBUffer<PrimaryGenData> primaryGenDataConst;
RWStructuredBuffer<PathPayload> paths; 
RWStructuredBuffer<uint> pathsContinueCounter;

[numthreads(32,1,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    if (id.x > pathsEndCounter[pathCount])
    {
        return;
    }

    int x = (id.x / primaryGenDataConst[0].pathsPerPixel) % primaryGenDataConst[0].screenWidth;
    int y = (id.x / primaryGenDataConst[0].pathsPerPixel) / primaryGenDataConst[0].screenWidth;
    float pixelDirXCamSpace = ((2 * x + 1) * primaryGenDataConst[0].invScreenHeight - primaryGenDataConst[0].screenWidth * primaryGenDataConst[0].invScreenHeight) * primaryGenDataConst[0].tanFovHalf;
    float pixelDirYCamSpace = ((-2 * y - 1) * primaryGenDataConst[0].invScreenHeight + 1) * primaryGenDataConst[0].tanFovHalf;

    // camera's image plane is at z = 1
    float3 pixelDirCamSpace = float3(pixelDirXCamSpace, pixelDirYCamSpace, 1);

    // direction vectors are uneffected by translations
    float3x3 cameraToWorld = quatToRotMatrix(primaryGenDataConst[0].quaternion);
    float3 pixelDirWorldSpace = mul(cameraToWorld, pixelDirCamSpace);

    uint pathId = pathsEndCounter[id.x];
    paths[pathId].direction = float4(pixelDirWorldSpace,0);

    uint prevIndex = pathsContinueCounter.IncrementCounter();
    pathsContinueCounter[prevIndex] = pathId;
}
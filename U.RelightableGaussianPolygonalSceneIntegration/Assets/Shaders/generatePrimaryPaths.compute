#pragma kernel CSMain
#include "utils.cginc"

RWStructuredBuffer<PathPayload> paths;
StructuredBuffer<int> pathsEndCounter;
RWStructuredBuffer<int> pathsContinueCounter;
StructuredBuffer<CameraParams> cameraParamsConst;

[numthreads(32,1,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    if (id > pathsEndCounter[pathCount])
    {
        return;
    }

    int x = (id / cameraParamsConst[0].pathsPerPixel) % cameraParamsConst[0].screenWidth;
    int y = (id / cameraParamsConst[0].pathsPerPixel) / cameraParamsConst[0].screenWidth;
    float pixelDirXCamPos = ((2 * x + 1) * cameraParamsConst[0].invScreenHeight - cameraParamsConst[0].screenWidth * cameraParamsConst[0].invScreenHeight) * cameraParamsConst[0].tanFovHalf;
    float pixelDirYCamPos = ((-2 * y - 1) * cameraParamsConst[0].invScreenHeight + 1) * cameraParamsConst[0].tanFovHalf;

    // Note: camera's image plane is at z = 1
    float3 pixelDirCamPos = float3(pixelDirXCamPos, pixelDirYCamPos, 1);

    // Note: direction vectors are uneffected by translations
    float3x3 cameraToWorld = quatToRotMatrix(cameraParamsConst[0].cameraQuaternion);
    float3 pixelDirWorldPos = mul(cameraToWorld, pixelDirCamPos);

    uint pathId = pathsEndCounter[id]
    paths[pathId].direction = pixelDirWorldPos;

    uint prevIndex = pathsContinueCounter.IncrementCounter();
    pathsContinueCounter[prevIndex] = pathId;
}
#pragma kernel CSMain
#include "Utils.cginc"

StructuredBuffer<uint> frameIndex;
StructuredBuffer<uint> pathsContinueTmpCounter;
StructuredBuffer<uint> pathsContinueTmpCounterValue;
StructuredBuffer<PathHitRecord> pathHitRecords;
int pathsPerPixel;
int screenWidth;
int pathBounce;
RWStructuredBuffer<PathPayload> paths;
RWStructuredBuffer<uint> pathsContinueCounter;
RWStructuredBuffer<uint3> currentFrameBuffer;

[numthreads(128,1,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    if (id.x > pathsContinueTmpCounterValue[0])
    {
        return;
    }

    uint pathId = pathsContinueTmpCounter[id.x];
    PathHitRecord hitRecord = pathHitRecords[pathId];

    uint2 pixelIndex = getPixelIndex(pathId, pathsPerPixel, screenWidth);

    if (hitRecord.materialType & MATERIAL_IS_EMISSIVE)
    {
        uint idx = (pathId / pathsPerPixel);
        float invPathsPerPixel = 1.0 / pathsPerPixel;
        uint3 color = (uint3) (paths[pathId].throughput * hitRecord.albedo * invPathsPerPixel * COLOR_SCALE).xyz;

        InterlockedAdd(currentFrameBuffer[idx].x, color.x);
        InterlockedAdd(currentFrameBuffer[idx].y, color.y);
        InterlockedAdd(currentFrameBuffer[idx].z, color.z);

        return;
    }

    // add normal offset to avoid collision with itself
    paths[pathId].origin += hitRecord.t * paths[pathId].direction + float4(hitRecord.normal,0) * EPSILON;

    int seed = getSeed(pathBounce, frameIndex[0], pathId);
    float3 lambertianDiffuse = hitRecord.albedo.rgb / PI;

    float3 L;
    float3 BRDF;
    if (hitRecord.materialType & MATERIAL_HAS_METALLIC_SMOOTHNESS_TEX)
    {
        float3 V = paths[pathId].direction.xyz;
        float3 N = hitRecord.normal;
        float metallic = hitRecord.metallic;
        float roughness = (1 - hitRecord.smoothness);
        float alpha = roughness * roughness;

        L = randGGXImportanceSample(hitRecord.normal, V, roughness, pixelIndex, seed);
        float3 H = normalize(L + V);

        float3 ks, kd;
        if (metallic)
        {
            ks = fresnelSchlick(hitRecord.albedo.rgb, V, H);
            kd = (1 - ks) * (1.0 - metallic);
        }
        else
        {
            ks = fresnelSchlick(BASE_DIELECTRIC_REFLECTIVITY, V, H);
            kd = 1 - ks;
        }

        // Cook-Torrance specular function https://learnopengl.com/PBR/Theory
        float3 cookTorranceNumerator = trowbridgeReitzNDF(alpha, N, H) * smithGSF(alpha, N, V, L) * ks;
        float cookTorranceDenominator = 4.0 * max(dot(V, N), 0.0) * max(dot(L,N), 0.0);
        cookTorranceDenominator = max(cookTorranceDenominator, EPSILON);
        float3 cookTorrance = cookTorranceNumerator / cookTorranceDenominator;

        BRDF = (kd * lambertianDiffuse + cookTorrance) * max(dot(L, N), 0.0) / ggxPDF(N, V, L, roughness);
    }
    else
    {
        // cosine weighted sample's pdf accounts for Lambert's Law
        L = randCosHemisphereSample(hitRecord.normal, pixelIndex, seed);
        BRDF = lambertianDiffuse;
    }
   
    paths[pathId].throughput *= float4(BRDF, 1);
    paths[pathId].direction = float4(L, 0);

    // add path to continue
    uint prevIndex = pathsContinueCounter.IncrementCounter();
    pathsContinueCounter[prevIndex] = pathId;
}
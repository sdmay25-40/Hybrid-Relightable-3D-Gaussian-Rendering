#pragma kernel CSMain
#include "utils.cginc"

StructuredBuffer<uint> frameIndex;
StructuredBuffer<uint> pathsContinueTmpCounter;
StructuredBuffer<uint> pathsContinueTmpCounterValue;
StructuredBuffer<PathHitRecord> pathHitRecords;
int pathsPerPixel;
int screenWidth;
int pathBounceLimit;
RWStructuredBuffer<PathPayload> paths;
RWStructuredBuffer<uint> pathsContinueCounter;
RWTexture2D<float4> renderTexture;

[numthreads(128,1,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    if (id.x > pathsContinueTmpCounterValue[0])
    {
        return;
    }

    uint pathId = pathsContinueTmpCounter[id.x];
    PathHitRecord hitRecord = pathHitRecords[pathId];

    uint2 pixelIndex = getPixelIndex(pathId, pathsPerPixel, screenWidth);

    if (hitRecord.materialType == 1) // emissive
    {
        // TODO: write to texture; += causes access issues w/ pathsPerPixel > 1
        // float invPathsPerPixel = 1.0 / pathsPerPixel;
        // renderTexture[pixelIndex] += paths[pathId].throughput * hitRecord.albedo * invPathsPerPixel;
        renderTexture[pixelIndex] = paths[pathId].throughput * hitRecord.albedo;
        return;
    }

    // add normal offset to avoid collision with itself
    paths[pathId].origin += (hitRecord.t * paths[pathId].direction).xyz +  hitRecord.normal * EPSILON;

    // cosine weighted sample accounts for Lambert's Law
    int seed = getSeed(paths[pathId].bounce, frameIndex[0]);
    float3 reflect = randCosHemisphereSample(hitRecord.normal, pixelIndex, seed);
    paths[pathId].direction = float4(reflect, 0);
    paths[pathId].bounce++;

    // Lambertian Diffuse BRDF
    paths[pathId].throughput *= hitRecord.albedo / PI;
   
    // add path to continue
    uint prevIndex = pathsContinueCounter.IncrementCounter();
    pathsContinueCounter[prevIndex] = pathId;
}
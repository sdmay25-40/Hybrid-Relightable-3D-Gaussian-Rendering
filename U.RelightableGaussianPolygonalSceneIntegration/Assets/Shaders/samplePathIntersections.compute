#pragma kernel CSMain
#include "utils.cginc"

StructuredBuffer<uint> pathsContinueTmpCounter;
StructuredBuffer<CameraParams> cameraParamsConst;
StructuredBuffer<PathHitRecord> pathHitRecords;
StructuredBuffer<MaterialData> materialDatas;
RWStructuredBuffer<uint> pathsContinueCounter;
RWTexture2D<float4> renderTexture;

[numthreads(32,1,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    if (id.x > pathsContinueTmpCounter[cameraParamsConst[0].pathCount])
    {
        return;
    }

    uint pathId = pathsContinueTmpCounter[id.x];
    PathHitRecord hitRecord = pathHitRecords[pathId];

    // write to pathsContinue
    if (hitRecord.t < FLT_MAX)
    {
        float4 color  = materialDatas[hitRecord.materialIndex].albedo;

        uint x = 0;
        uint y = 0;
        renderTexture[uint2(x,y)] = color;
    }
}
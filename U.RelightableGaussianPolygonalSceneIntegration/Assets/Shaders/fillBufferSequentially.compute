#pragma kernel CSMain

RWStructuredBuffer<uint> counterBuffer; // ComputeBufferType.Counter
uint count;

[numthreads(32,1,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    if (id.x < count)
    {
        uint prevIndex = counterBuffer.IncrementCounter();
        counterBuffer[prevIndex] = prevIndex;
    }
}